{
  "name": "fys-playwright-js",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "npm run test:local",
    "check:setup": "node scripts/check-setup.js",
    "test:all-live": "playwright test",
    "test:login": "playwright test --grep @login",
    "test:washing": "playwright test --grep @washing",
    "test:short-term": "playwright test --grep @short-term",
    "test:corporate": "playwright test tests/ui/corporate-short-term.spec.js",
    "test:lifecycle": "playwright test --grep @lifecycle",
    "test:mono": "playwright test --grep @mono-ui",
    "test:mono-api": "playwright test --grep @mono-api",
    "test:reservation-api": "playwright test --grep @reservation-api",
    "test:api": "playwright test --grep @api",
    "test:broker:read": "BROKER_REQUIRE_CONFIG=true TEST_ENV=dev playwright test --project=dev-broker tests/broker/collection-get.spec.js tests/broker/available-cars.spec.js",
    "test:broker:save": "BROKER_REQUIRE_CONFIG=true TEST_ENV=dev playwright test --project=dev-broker tests/broker/booking-save.spec.js",
    "test:broker:cancel": "BROKER_REQUIRE_CONFIG=true TEST_ENV=dev playwright test --project=dev-broker tests/broker/booking-cancel.spec.js",
    "test:long-term": "TEST_ENV=dev playwright test --project=dev-long-term",
    "test:monthly": "TEST_ENV=dev playwright test --project=dev-monthly",
    "test:fayt-maintenance": "TEST_ENV=dev playwright test --project=dev-fayt-maintenance",
    "test:fayt-fuel": "TEST_ENV=validation playwright test --project=validation-fayt-fuel",
    "test:local": "node --test tests/local/*.test.js",
    "test:headed": "playwright test --headed",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium"
  },
  "dependencies": { "fast-xml-parser": "5.11.2" },
  "devDependencies": { "@playwright/test": "1.63.0", "dotenv": "17.2.3" }
}
