# validation | dev | all
TEST_ENV=validation
# Gerçek kayıt oluşturan testler için ayrıca true yapılmalıdır.
ALLOW_WRITE_TESTS=false
VALIDATION_BASE_URL=https://fys-validation.n2mobil.co
DEV_BASE_URL=https://dev-fys.n2mobil.co
VALIDATION_EMAIL=
VALIDATION_PASSWORD=
DEV_EMAIL=
DEV_PASSWORD=
# CI için sözleşmesi olan, bu testlere ayrılmış plaka önerilir.
# Boşsa açılan araç listesinden rastgele seçim yapılır.
VALIDATION_VEHICLE_PLATE=
DEV_VEHICLE_PLATE=
VALIDATION_WORKFLOW_KEY=standart_yikama
DEV_WORKFLOW_KEY=standart_yikama
# virgülle ayrılmış alt alan seçenekleri (örnek: Mono için tam seçenek metni)
# İsteğe bağlı: VALIDATION_MONO=..., DEV_MONO=...
ACTION_TIMEOUT_MS=15000
LOGIN_TIMEOUT_MS=30000
SAVE_TIMEOUT_MS=30000
TEST_TIMEOUT_MS=240000
# Kısa dönem yaşam döngüsü: bugün, çalıştırıldığı dakikada başlar ve 7 gün sürer.
VALIDATION_SHORT_TERM_START_OFFSET_DAYS=0
VALIDATION_SHORT_TERM_DURATION_DAYS=7
DEV_SHORT_TERM_START_OFFSET_DAYS=0
DEV_SHORT_TERM_DURATION_DAYS=7

# Ortak sözleşme → teslim → iade akışı.
# Normal kısa dönem provizyonu 0 alınır; kurumsal akış bu adımı atlar.
VALIDATION_PROVISION_AMOUNT=0
DEV_PROVISION_AMOUNT=0
VALIDATION_RETURN_KM_INCREMENT=30
DEV_RETURN_KM_INCREMENT=30
# Uygulamadaki yakıt ölçeği 0-8 arasındadır.
VALIDATION_RETURN_FUEL=2
DEV_RETURN_FUEL=2

# Kurumsal kısa dönem: sözleşme ve müşteri her ortamda açıkça tanımlanır.
VALIDATION_CORPORATE_CONTRACT_NUMBER=KKD1231231232201
VALIDATION_CORPORATE_CUSTOMER_IDENTITY=87654345345
DEV_CORPORATE_CONTRACT_NUMBER=KKD5281291313401
DEV_CORPORATE_CUSTOMER_IDENTITY=63875054462

# Test senaryosu. Süre 31 günden uzunsa uygulamadaki Aylık Özelleştir
# periyotları tek tek işlenir. Hizmet boşsa ilk uygun hizmet seçilir.
VALIDATION_CORPORATE_DURATION_DAYS=45
DEV_CORPORATE_DURATION_DAYS=45
VALIDATION_CORPORATE_ADDITIONAL_SERVICE=
DEV_CORPORATE_ADDITIONAL_SERVICE=
VALIDATION_CORPORATE_INVOICE_TYPE=Full credit
DEV_CORPORATE_INVOICE_TYPE=Full credit

# Mevcut müşteri ehliyet ve fatura adresine sahipse ek kurumsal müşteri alanı gerekmez.
# Eksik bilgi modalı açılırsa yalnız gereken alanlar docs/CORPORATE_SHORT_TERM.md içinde.

# Hatalı UI/API testlerinde trace otomatik saklanır. Broker trace her zaman kapalıdır.
# Trace oturum/istek bilgileri içerebilir; gerekirse FYS_TRACE=off kullanın.
FYS_TRACE=retain-on-failure
IGNORE_HTTPS_ERRORS=false

# Python API akışından eklenen broker testleri. Değerleri yalnız .env veya GitLab Variables'a yazın.
BROKER_TOKEN=
BROKER_COMPANY_ID=
BROKER_APPLICATION_ID=
BROKER_TEST_NAME=
BROKER_TEST_SURNAME=
BROKER_TEST_MOBILE_PHONE=
BROKER_TEST_EMAIL=
# BROKER_AUTH_SCHEME=
# BROKER_DAYS_AHEAD=
# BROKER_RENTAL_DAYS=
# BROKER_PICKUP_ID=
# BROKER_DROP_OFF_ID=
# BROKER_CURRENCY=
# BROKER_HOUR=
# BROKER_TEST_RENTAL_ID=
# BROKER_GENERATE_RENTAL_ID=
# BROKER_ECOP_ID=
# BROKER_FULL_CREDIT=

# Yeni uzun dönem ve aylık arayüz senaryoları.
LONG_DEV_EMAIL=
DEV_E2E_CUSTOMER_NAME=
E2E_VEHICLE_GROUP=
DEV_MONTHLY_CUSTOMER_IDENTITY_NO=
